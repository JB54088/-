# Copy to deploy/production.env on the ECS host and replace all secrets.
POSTGRES_DB=customer_assets
POSTGRES_USER=customer_assets
POSTGRES_PASSWORD=replace-with-a-long-random-hex-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-hex-secret
JWT_EXPIRE_MINUTES=720
INITIAL_ADMIN01_PASSWORD=replace-with-a-unique-strong-password
INITIAL_ADMIN02_PASSWORD=replace-with-a-unique-strong-password
INITIAL_SALES01_PASSWORD=replace-with-a-unique-strong-password
INITIAL_SALES02_PASSWORD=replace-with-a-unique-strong-password
INITIAL_SALES03_PASSWORD=replace-with-a-unique-strong-password

# Set to the final HTTPS origin when a domain/TLS endpoint is configured.
# For loopback-only verification, use http://127.0.0.1:8080.
APP_ORIGIN=http://127.0.0.1:8080

EXCEL_MAX_FILE_SIZE_MB=20
EXCEL_MAX_ROWS=50000
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=business-analysis-mock
AI_MOCK_MODE=true
